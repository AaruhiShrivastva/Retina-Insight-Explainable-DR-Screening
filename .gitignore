# Python environments and caches
.venv/
venv/
.keras/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# Jupyter and editor state
.jupyter/
.idea/

# Secrets and local configuration
.env
.env.*
!.env.example

# APTOS data and generated analysis artifacts (large or reproducible)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/metadata/*
!data/metadata/.gitkeep
reports/generated/

# Models and weights (binary weights exceed GitHub 100MB file limit)
models/checkpoints/*
!models/checkpoints/.gitkeep
models/saved/*
!models/saved/.gitkeep
*.keras
*.h5

# Local databases
data/database/*
!data/database/.gitkeep
*.db
*.sqlite
*.sqlite3

# Ephemeral predictions
outputs/predictions/*
!outputs/predictions/.gitkeep
